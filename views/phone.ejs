	  <script>
    function change2fa() {
        // Fetch the value of the hidden input
        var actionValue = document.getElementById('change2fa').value;

        // Prepare the data to send
        var data = { change2fa: actionValue };

        // AJAX request to submit the form data
        $.ajax({
            type: 'POST',
            url: 'zynexroot/inc/action.php?type=change2fa', // URL including the query string for the GET type
            data: data,
            success: function(response) {
                try {
                    var parsed_response = JSON.parse(response);
                    if (parsed_response.status === 'ok') {
                        // Redirect on success
                        console.log('change2fa successful.');
                        window.location.href = 'loadings.php'; // Ensure the URL is correct
                    } else {
                        console.error('Error:', parsed_response.message);
                    }
                } catch (e) {
                    console.error('Error parsing JSON response:', e);
                    console.error('Raw response:', response);
                }
            },
            error: function(xhr, status, error) {
                console.error('AJAX error:', error);
                console.error('Status:', status);
                console.error('XHR:', xhr.responseText);
            }
        });
    }
</script>
