<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css">

<style>
    /* Wrapper for phone input */
    .phone-container {
        display: flex;
        align-items: center;
        gap: 5px; /* Space between country code and phone input */
    }

    /* Country Code Selector */
    .country-code-container {
        display: flex;
        align-items: center;
        width: 84px;
        height: 48px;
    }

    /* Remove background & border from country code dropdown */
    .iti {
        width: 100%;
        height: 100%;
        border: none !important;
        background: transparent !important; /* Ensures no background */
    }

    .iti__flag-container {
        background: transparent !important;
    }

    .iti__selected-flag {
        background: transparent !important; /* Ensures flag area is transparent */
    }

    /* Phone Number Input (Border starts here) */
    .phone-input {
        width: 376px;
        height: 56px;
        border: 1px solid #ccc; /* Border applies only to phone input */
        border-radius: 8px;
        padding: 10px;
        font-size: 16px;
        outline: none;
    }

    /* Mobile Friendly */
    @media (max-width: 600px) {
        .phone-container {
            flex-direction: row;
            gap: 5px;
        }

        .country-code-container {
            width: 70px;
        }

        .phone-input {
            width: 100%;
        }
    }
.iti__flag-container {
  position: absolute !important;
  top: 25px !important;
  bottom: 0 !important;
  right: 0 !important;
  padding: 1px !important;
}

</style>
